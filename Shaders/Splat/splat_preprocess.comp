// splat_preprocess.comp - 3DGS Preprocess Compute Shader
// 
// Computes per-Gaussian: frustum culling, 3D covariance, 2D projection, 
// EWA conic, 3-sigma radius, tile bounds, SH color evaluation.
//
// Reference: 3dgs-vulkan-cpp/vulkan-3dgs/src/Shaders/preprocess.comp
//
// Descriptor Sets:
//   Set 0 (Input): positions, scales, rotations, opacities, shCoeffs, CameraUBO
//   Set 1 (Output): radii, depth, rgb, conicOpacity, pointsXY, tilesTouched, bbox
//   Push Constants: gaussianCount, near, far, culling, gaussianScale

#version 450
#extension GL_GOOGLE_include_directive : enable
#include "splat_common.glsl"
#include "splat_tight_culling.glsl"
#include "splat_projection_color.glsl"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// ============================================================================
// Push Constants (40 bytes of fields; CPU range padded to 48 bytes)
// ============================================================================
layout(push_constant) uniform PushConstants {
    uint gaussianCount;
    float near;
    float far;
    uint culling;
    float gaussianScale;
    uint useActiveIndices;
    uint sourceCapacity;
    uint shStride;
    uint tightTileCulling;
    uint shStorageMode; // offset 36, CPU range remains 48 bytes
    uint projectionColorStorageMode; // offset 40
} pc;

// ============================================================================
// Descriptor Set 0: Input Data + Camera
// ============================================================================

layout(std430, set = 0, binding = 0) readonly buffer GaussianPositions {
    vec4 positions[];
};

layout(std430, set = 0, binding = 1) readonly buffer GaussianScales {
    vec4 scales[];
};

layout(std430, set = 0, binding = 2) readonly buffer GaussianRotations {
    vec4 rotations[];
};

layout(std430, set = 0, binding = 3) readonly buffer GaussianOpacities {
    float opacities[];
};

layout(std430, set = 0, binding = 4) readonly buffer GaussianSH {
    uint shWords[];
};

layout(std140, set = 0, binding = 5) uniform CameraUniforms {
    mat4 viewMatrix;
    mat4 projMatrix;
    vec4 camPos;
    float focalX;
    float focalY;
    float tanFovX;
    float tanFovY;
    int imageWidth;
    int imageHeight;
    int shDegree;
} camera;

layout(std430, set = 0, binding = 6) readonly buffer ActiveIndices { uint activeIndices[]; };

// ============================================================================
// Descriptor Set 1: Output Buffers
// ============================================================================

layout(std430, set = 1, binding = 0) writeonly buffer OutputRadii {
    int radii[];
};

layout(std430, set = 1, binding = 1) writeonly buffer OutputDepth {
    float depth[];
};

layout(std430, set = 1, binding = 2) writeonly buffer OutputRGB {
    uint rgbWords[];
};

layout(std430, set = 1, binding = 3) writeonly buffer OutputConicOpacity {
    vec4 conicOpacity[];
};

layout(std430, set = 1, binding = 4) writeonly buffer OutputPointsXY {
    vec2 pointsXY[];
};

layout(std430, set = 1, binding = 5) writeonly buffer OutputTilesTouched {
    uint tilesTouched[];
};

layout(std430, set = 1, binding = 6) writeonly buffer OutputBBox {
    uvec4 bbox[];
};

// ============================================================================
// SH Color Evaluation (inlined: needs direct buffer access)
// Reference: preprocess.comp::computeColorFromSH
// ============================================================================
float readSH(uint scalarIndex) {
    if (pc.shStorageMode == 1u) {
        vec2 values = unpackHalf2x16(shWords[scalarIndex >> 1u]);
        return values[scalarIndex & 1u];
    }
    return uintBitsToFloat(shWords[scalarIndex]);
}
vec3 computeColorFromSH(vec3 pos, vec3 camPos, int shDegree, uint shBase) {
    vec3 dir = normalize(pos - camPos);

    // Degree 0
    vec3 result = SH_C0 * vec3(
        readSH(shBase * 3 + 0),
        readSH(shBase * 3 + 1),
        readSH(shBase * 3 + 2)
    );

    if (shDegree > 0) {
        float x = dir.x, y = dir.y, z = dir.z;

        // Degree 1
        result = result - SH_C1 * y * vec3(
            readSH((shBase + 1) * 3 + 0),
            readSH((shBase + 1) * 3 + 1),
            readSH((shBase + 1) * 3 + 2)
        ) + SH_C1 * z * vec3(
            readSH((shBase + 2) * 3 + 0),
            readSH((shBase + 2) * 3 + 1),
            readSH((shBase + 2) * 3 + 2)
        ) - SH_C1 * x * vec3(
            readSH((shBase + 3) * 3 + 0),
            readSH((shBase + 3) * 3 + 1),
            readSH((shBase + 3) * 3 + 2)
        );

        if (shDegree > 1) {
            float xx = x * x, yy = y * y, zz = z * z;
            float xy = x * y, yz = y * z, xz = x * z;

            // Degree 2
            result = result +
                SH_C2[0] * xy * vec3(
                    readSH((shBase + 4) * 3 + 0),
                    readSH((shBase + 4) * 3 + 1),
                    readSH((shBase + 4) * 3 + 2)
                ) +
                SH_C2[1] * yz * vec3(
                    readSH((shBase + 5) * 3 + 0),
                    readSH((shBase + 5) * 3 + 1),
                    readSH((shBase + 5) * 3 + 2)
                ) +
                SH_C2[2] * (2.0 * zz - xx - yy) * vec3(
                    readSH((shBase + 6) * 3 + 0),
                    readSH((shBase + 6) * 3 + 1),
                    readSH((shBase + 6) * 3 + 2)
                ) +
                SH_C2[3] * xz * vec3(
                    readSH((shBase + 7) * 3 + 0),
                    readSH((shBase + 7) * 3 + 1),
                    readSH((shBase + 7) * 3 + 2)
                ) +
                SH_C2[4] * (xx - yy) * vec3(
                    readSH((shBase + 8) * 3 + 0),
                    readSH((shBase + 8) * 3 + 1),
                    readSH((shBase + 8) * 3 + 2)
                );

            if (shDegree > 2) {
                // Degree 3
                result = result +
                    SH_C3[0] * y * (3.0 * xx - yy) * vec3(
                        readSH((shBase + 9) * 3 + 0),
                        readSH((shBase + 9) * 3 + 1),
                        readSH((shBase + 9) * 3 + 2)
                    ) +
                    SH_C3[1] * xy * z * vec3(
                        readSH((shBase + 10) * 3 + 0),
                        readSH((shBase + 10) * 3 + 1),
                        readSH((shBase + 10) * 3 + 2)
                    ) +
                    SH_C3[2] * y * (4.0 * zz - xx - yy) * vec3(
                        readSH((shBase + 11) * 3 + 0),
                        readSH((shBase + 11) * 3 + 1),
                        readSH((shBase + 11) * 3 + 2)
                    ) +
                    SH_C3[3] * z * (2.0 * zz - 3.0 * xx - 3.0 * yy) * vec3(
                        readSH((shBase + 12) * 3 + 0),
                        readSH((shBase + 12) * 3 + 1),
                        readSH((shBase + 12) * 3 + 2)
                    ) +
                    SH_C3[4] * x * (4.0 * zz - xx - yy) * vec3(
                        readSH((shBase + 13) * 3 + 0),
                        readSH((shBase + 13) * 3 + 1),
                        readSH((shBase + 13) * 3 + 2)
                    ) +
                    SH_C3[5] * z * (xx - yy) * vec3(
                        readSH((shBase + 14) * 3 + 0),
                        readSH((shBase + 14) * 3 + 1),
                        readSH((shBase + 14) * 3 + 2)
                    ) +
                    SH_C3[6] * x * (xx - 3.0 * yy) * vec3(
                        readSH((shBase + 15) * 3 + 0),
                        readSH((shBase + 15) * 3 + 1),
                        readSH((shBase + 15) * 3 + 2)
                    );
            }
        }
    }

    result += 0.5;
    return max(result, vec3(0.0));
}

// ============================================================================
// Main entry point
// ============================================================================
void main() {
    uint idx = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 256u + gl_LocalInvocationID.x;

    if (idx >= pc.gaussianCount) return;

    int BLOCK_X = 16;
    int BLOCK_Y = 16;
    int gridX = (camera.imageWidth  + BLOCK_X - 1) / BLOCK_X;
    int gridY = (camera.imageHeight + BLOCK_Y - 1) / BLOCK_Y;

    // Initialize outputs
    uint sourceIdx = pc.useActiveIndices != 0u ? activeIndices[idx] : idx;
    radii[idx] = 0;
    tilesTouched[idx] = 0;
    depth[idx] = 0;
    // Culled Gaussians must not retain last frame's tile rectangle. AssignKeys
    // uses bbox to decide whether to emit entries, even when tilesTouched is 0.
    bbox[idx] = uvec4(0u);
    if (sourceIdx >= pc.sourceCapacity) return;

    // Step 1.4: Frustum culling
    vec3 pView;
    bool inFrust = inFrustum(positions[sourceIdx].xyz, camera.viewMatrix, camera.projMatrix, pc.near, pc.far, pView);
    if (pc.culling != 0u && !inFrust) return;
    // Even with distance culling disabled, projection cannot cross the eye
    // plane or the Jacobian denominator becomes undefined.
    if (pView.z >= -0.0001) return;

    // Transform to clip space for NDC -> pixel conversion
    vec4 pOrig = positions[sourceIdx];
    vec4 pHom = camera.projMatrix * camera.viewMatrix * pOrig;
    float pW = 1.0 / (pHom.w + 0.0000001);
    vec3 pProj = pHom.xyz * pW;

    // Step 1.3: Compute 3D covariance
    float cov3D_data[6];
    computeCov3D(scales[sourceIdx].xyz, rotations[sourceIdx], pc.gaussianScale, cov3D_data);

    // Step 1.5: Compute 2D covariance (Jacobian + projection)
    vec3 cov2D = computeCov2D(pView, cov3D_data, camera.viewMatrix, camera.focalX, camera.focalY, camera.tanFovX, camera.tanFovY, camera.projMatrix[2].xy);

    // Step 1.6: EWA conic (invert 2D covariance)
    float det = cov2D.x * cov2D.z - cov2D.y * cov2D.y;
    if (det <= 0.0 || isnan(det) || isinf(det)) return;

    float detInv = 1.0 / det;
    vec3 conic = vec3(cov2D.z * detInv, -cov2D.y * detInv, cov2D.x * detInv);

    // 3-sigma radius
    float mid = 0.5 * (cov2D.x + cov2D.z);
    float lambda1 = mid + sqrt(max(0.1, mid * mid - det));
    float lambda2 = mid - sqrt(max(0.1, mid * mid - det));
    float myRadius = ceil(3.0 * sqrt(max(lambda1, lambda2)));
    if (isnan(myRadius) || isinf(myRadius)) return;

    // Screen-space coordinates (NDC -> pixels)
    vec2 pointImage = vec2(
        ndc2Pix(pProj.x, camera.imageWidth),
        ndc2Pix(pProj.y, camera.imageHeight)
    );
    if (any(isnan(pointImage)) || any(isinf(pointImage))) return;

    // Tile bounding box
    ivec2 rectMin = ivec2(
        int(clamp((pointImage.x - myRadius) / BLOCK_X, 0.0, float(gridX))),
        int(clamp((pointImage.y - myRadius) / BLOCK_Y, 0.0, float(gridY)))
    );
    ivec2 rectMax = ivec2(
        int(clamp((pointImage.x + myRadius + BLOCK_X - 1) / BLOCK_X, 0.0, float(gridX))),
        int(clamp((pointImage.y + myRadius + BLOCK_Y - 1) / BLOCK_Y, 0.0, float(gridY)))
    );

    uvec4 tileRect = uvec4(rectMin.x, rectMin.y, rectMax.x, rectMax.y);
    SplatTightSupport support;
    if (pc.tightTileCulling != 0u) {
        support = splatTightSupport(vec4(conic, opacities[sourceIdx]), pointImage);
        tileRect = splatTightRect(tileRect, pointImage, support, uvec2(gridX, gridY), pc.tightTileCulling);
    }
    if (tileRect.x >= tileRect.z || tileRect.y >= tileRect.w) return;
    uint retained = (tileRect.z - tileRect.x) * (tileRect.w - tileRect.y);
    if (pc.tightTileCulling == 2u) {
        retained = 0u;
        for (uint y = tileRect.y; y < tileRect.w; ++y)
            for (uint x = tileRect.x; x < tileRect.z; ++x)
                if (splatTileRetained(uvec2(x,y), pointImage, support,
                    uvec2(camera.imageWidth, camera.imageHeight), pc.tightTileCulling)) ++retained;
    }
    if (retained == 0u) return;
    bbox[idx] = tileRect;

    // Step 1.7: SH color
    vec3 color = computeColorFromSH(positions[sourceIdx].xyz, camera.camPos.xyz, camera.shDegree, sourceIdx * pc.shStride);

    // Write outputs
    depth[idx] = -pView.z;
    radii[idx] = int(min(myRadius, 2147483520.0));
    pointsXY[idx] = pointImage;
    conicOpacity[idx] = vec4(conic, opacities[sourceIdx]);
    tilesTouched[idx] = retained;
    if (pc.projectionColorStorageMode == 1u) {
        uvec2 packedColor = splatEncodeProjectionColor(color);
        rgbWords[idx * 2u] = packedColor.x;
        rgbWords[idx * 2u + 1u] = packedColor.y;
    } else {
        rgbWords[idx * 4u] = floatBitsToUint(color.r);
        rgbWords[idx * 4u + 1u] = floatBitsToUint(color.g);
        rgbWords[idx * 4u + 2u] = floatBitsToUint(color.b);
        rgbWords[idx * 4u + 3u] = 0u;
    }
}
