// splat_render.comp - Per-Tile 3DGS Alpha Blend Renderer
//
// Each workgroup processes one 16×16 tile. Reads the sorted Gaussian list
// for the tile (from radix sort + tile boundaries) and performs front-to-back 
// EWA (Elliptical Weighted Average) alpha blending.
//
// Reference: 3dgs-vulkan-cpp render.comp / 3DGS.cpp render.comp

#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : enable
#extension GL_GOOGLE_include_directive : enable
#include "../splat_projection_color.glsl"

#define TILE_WIDTH  16
#define TILE_HEIGHT 16

layout(local_size_x = TILE_WIDTH, local_size_y = TILE_HEIGHT, local_size_z = 1) in;

// ============================================================================
// Descriptor Set 0
// ============================================================================

// Tile ranges: ranges[tileID] = uvec2(startIndex, endIndexExclusive)
// Tiles with no Gaussians have (0, 0) — no iteration needed.
layout(std430, set = 0, binding = 0) readonly buffer TileRangesBuf {
    uvec2 tileRanges[];         // From tile boundaries pass
};

// Sorted Gaussian IDs: output of radix sort (values)
// Each entry corresponds to a sort key; value[i] = Gaussian index
layout(std430, set = 0, binding = 1) readonly buffer SortedIdsBuf {
    uint sortedIds[];           // From radix sort values
};

// Pre-computed Gaussian color (SH evaluation result)
layout(std430, set = 0, binding = 2) readonly buffer ColorBuf {
    uint colorWords[];          // FP32 vec4 (4 words) or RGB21F (2 words).
};

// Pre-computed conic + opacity: conicOpacity[idx] = vec4(conic.xy, conic.z, opacity)
layout(std430, set = 0, binding = 3) readonly buffer ConicOpacityBuf {
    vec4 conicOpacity[];        // From preprocess output
};

// Pre-computed screen-space 2D positions
layout(std430, set = 0, binding = 4) readonly buffer PointsXYBuf {
    vec2 pointsXY[];            // From preprocess output
};

// Output image: writes final blended color
layout(set = 0, binding = 5, rgba8) uniform writeonly image2D outputImage;
layout(std430, set = 0, binding = 6) readonly buffer DispatchState { uint state[]; };

// ============================================================================
// Push Constants (20 bytes)
// ============================================================================
layout(push_constant) uniform PushConstants {
    uint imageWidth;            // Viewport width in pixels
    uint imageHeight;           // Viewport height in pixels
    uint wireframe;             // Draw projected Gaussian ellipse contours
    uint forceClear;
    uint rasterSharedMemoryMode; // 0=original, 1=shared-memory batch64
    uint projectionColorStorageMode;
} pc;

vec3 readProjectionColor(uint index) {
    if (pc.projectionColorStorageMode == 1u)
        return splatDecodeProjectionColor(uvec2(colorWords[index * 2u], colorWords[index * 2u + 1u]));
    return uintBitsToFloat(uvec3(colorWords[index * 4u], colorWords[index * 4u + 1u], colorWords[index * 4u + 2u]));
}

// ============================================================================
// Main
// ============================================================================
void renderOriginal() {
    if (pc.forceClear == 0u && state[1] != 0u) return;
    uint tileX = gl_WorkGroupID.x;
    uint tileY = gl_WorkGroupID.y;
    uint localX = gl_LocalInvocationID.x;
    uint localY = gl_LocalInvocationID.y;

    // Pixel coordinate for this thread
    uvec2 pixel = uvec2(tileX * TILE_WIDTH + localX, tileY * TILE_HEIGHT + localY);

    if (pixel.x >= pc.imageWidth || pixel.y >= pc.imageHeight) {
        return; // Out of bounds
    }

    if (pc.forceClear == 1u) { imageStore(outputImage, ivec2(pixel), vec4(0.0)); return; }

    // Tile grid dimensions
    uint tilesPerRow = (pc.imageWidth  + TILE_WIDTH  - 1u) / TILE_WIDTH;
    uint tileID = tileX + tileY * tilesPerRow;

    // Get sorted range for this tile
    // Note: tileRanges is indexed by tileID, not by a linear offset
    uvec2 range = tileRanges[tileID];
    uint start = range.x;
    uint end   = pc.forceClear == 0u ? min(range.y, state[0]) : range.y;

    if (start >= end) {
        imageStore(outputImage, ivec2(pixel), vec4(0.0));
        return;
    }

    // Alpha blend state
    float T = 1.0;               // Transmittance (starts fully transparent)
    vec3  C = vec3(0.0);         // Accumulated color
    float outlineWeight = 0.0;
    vec3 outlineColor = vec3(1.0);

    // Iterate over sorted Gaussians for this tile (front-to-back by depth)
    for (uint i = start; i < end; i++) {
        uint gaussIdx = sortedIds[i];
        if (pc.forceClear == 0u && gaussIdx >= state[2]) continue;

        // Screen-space distance from pixel to Gaussian center
        vec2 xy = pointsXY[gaussIdx];
        vec2 d  = xy - vec2(pixel);

        // EWA conic evaluation: computes exp(-0.5 * d^T Σ^{-1} d)
        // conicOpacity[gaussIdx] = vec4(conic_xx, conic_xy, conic_yy, opacity)
        vec4 con_o = conicOpacity[gaussIdx];
        float power = -0.5 * (con_o.x * d.x * d.x + con_o.z * d.y * d.y)
                      - con_o.y * d.x * d.y;

        // Skip if pixel is outside the splat's support
        if (power > 0.0) {
            continue;
        }

        float alpha = min(0.99, con_o.w * exp(power));

        // Skip near-transparent contributions
        if (alpha < 1.0 / 255.0) {
            continue;
        }

        // Overlay a roughly one-pixel 2-sigma contour over the normal splat.
        // Very large projected ellipses are omitted from the overlay because
        // their contours dominate the image without adding useful detail.
        if (pc.wireframe != 0u && (gaussIdx & 255u) == 0u &&
            T > 0.02 && abs(power + 2.0) < 0.3) {
            float det = con_o.x * con_o.z - con_o.y * con_o.y;
            float trace = con_o.x + con_o.z;
            float lambdaMax = 0.5 * (trace + sqrt(max(trace * trace - 4.0 * det, 0.0)));
            float lambdaMin = det / max(lambdaMax, 1e-8);
            float radius = 2.0 * inversesqrt(max(lambdaMin, 1e-8));
            vec2 gradient = vec2(con_o.x * d.x + con_o.y * d.y,
                                 con_o.y * d.x + con_o.z * d.y);
            float lineWidth = min(0.3, max(0.025, length(gradient) * 1.25));
            if (det > 0.0 && radius <= 48.0 && abs(power + 2.0) <= lineWidth) {
                outlineWeight = max(outlineWeight, min(0.55, T * 0.55));
                outlineColor = mix(readProjectionColor(gaussIdx), vec3(1.0), 0.65);
            }
        }

        // Early exit: pixel is fully opaque
        float T_next = T * (1.0 - alpha);
        // Front-to-back alpha blending
        C += readProjectionColor(gaussIdx) * alpha * T;
        T = T_next;
        if (T < 0.0001) {
            break;
        }
    }

    C = mix(C, outlineColor, outlineWeight);
    imageStore(outputImage, ivec2(pixel), vec4(C, 1.0 - T));
}

// One loader per record; FP32 attributes and original IDs retain blend/overlay semantics.
const uint RASTER_BATCH_SIZE = 64u;
shared vec2 batchXY[64];
shared vec4 batchConicOpacity[64];
shared vec3 batchRGB[64];
shared uint batchIds[64];
shared uint batchValid[64];
shared uint completedPixels;

void renderShared() {
    // Dispatch state and forceClear are workgroup-uniform. Only these guards
    // may return before the batch barriers; edge/done lanes must stay alive.
    if (pc.forceClear == 0u && state[1] != 0u) return;
    uvec2 tileOrigin = gl_WorkGroupID.xy * uvec2(TILE_WIDTH, TILE_HEIGHT);
    uvec2 pixel = tileOrigin + gl_LocalInvocationID.xy;
    bool inBounds = pixel.x < pc.imageWidth && pixel.y < pc.imageHeight;
    if (pc.forceClear == 1u) {
        if (inBounds) imageStore(outputImage, ivec2(pixel), vec4(0.0));
        return;
    }

    uint tilesPerRow = (pc.imageWidth + TILE_WIDTH - 1u) / TILE_WIDTH;
    uint tileID = gl_WorkGroupID.x + gl_WorkGroupID.y * tilesPerRow;
    uvec2 range = tileRanges[tileID];
    uint end = pc.forceClear == 0u ? min(range.y, state[0]) : range.y;
    if (range.x >= end) {
        if (inBounds) imageStore(outputImage, ivec2(pixel), vec4(0.0));
        return;
    }

    uint lane = gl_LocalInvocationIndex;
    if (lane == 0u) {
        uvec2 extent = min(uvec2(TILE_WIDTH, TILE_HEIGHT),
            uvec2(pc.imageWidth, pc.imageHeight) - tileOrigin);
        completedPixels = TILE_WIDTH * TILE_HEIGHT - extent.x * extent.y;
    }
    bool done = !inBounds;
    float T = 1.0;
    vec3 C = vec3(0.0);
    float outlineWeight = 0.0;
    vec3 outlineColor = vec3(1.0);

    for (uint batchStart = range.x; batchStart < end;) {
        uint batchCount = min(RASTER_BATCH_SIZE, end - batchStart);
        // Tail slots are explicitly invalid. Invalid IDs never fetch attributes.
        // Completed and out-of-image loader lanes still perform these loads.
        if (lane < RASTER_BATCH_SIZE) {
            batchValid[lane] = 0u;
            if (lane < batchCount) {
                uint gaussIdx = sortedIds[batchStart + lane];
                if (pc.forceClear != 0u || gaussIdx < state[2]) {
                    batchIds[lane] = gaussIdx;
                    batchXY[lane] = pointsXY[gaussIdx];
                    batchConicOpacity[lane] = conicOpacity[gaussIdx];
                    batchRGB[lane] = readProjectionColor(gaussIdx);
                    batchValid[lane] = 1u;
                }
            }
        }
        // Publish staged records (and initial completedPixels) to every lane.
        barrier();
        bool wasDone = done;
        if (!done) {
            for (uint j = 0u; j < batchCount; ++j) {
                if (batchValid[j] == 0u) continue;
                uint gaussIdx = batchIds[j];
                vec2 xy = batchXY[j];
                vec2 d = xy - vec2(pixel);
                vec4 con_o = batchConicOpacity[j];
                float power = -0.5 * (con_o.x * d.x * d.x + con_o.z * d.y * d.y)
                              - con_o.y * d.x * d.y;
                if (power > 0.0) continue;
                float alpha = min(0.99, con_o.w * exp(power));
                if (alpha < 1.0 / 255.0) continue;

                if (pc.wireframe != 0u && (gaussIdx & 255u) == 0u &&
                    T > 0.02 && abs(power + 2.0) < 0.3) {
                    float det = con_o.x * con_o.z - con_o.y * con_o.y;
                    float trace = con_o.x + con_o.z;
                    float lambdaMax = 0.5 * (trace + sqrt(max(trace * trace - 4.0 * det, 0.0)));
                    float lambdaMin = det / max(lambdaMax, 1e-8);
                    float radius = 2.0 * inversesqrt(max(lambdaMin, 1e-8));
                    vec2 gradient = vec2(con_o.x * d.x + con_o.y * d.y,
                                         con_o.y * d.x + con_o.z * d.y);
                    float lineWidth = min(0.3, max(0.025, length(gradient) * 1.25));
                    if (det > 0.0 && radius <= 48.0 && abs(power + 2.0) <= lineWidth) {
                        outlineWeight = max(outlineWeight, min(0.55, T * 0.55));
                        outlineColor = mix(batchRGB[j], vec3(1.0), 0.65);
                    }
                }

                float T_next = T * (1.0 - alpha);
                C += batchRGB[j] * alpha * T;
                T = T_next;
                if (T < 0.0001) { done = true; break; }
            }
        }
        if (done && !wasDone) atomicAdd(completedPixels, 1u);
        // Every consumer has finished before loaders reuse shared storage.
        // This also publishes completion so the workgroup exits uniformly.
        barrier();
        if (completedPixels == TILE_WIDTH * TILE_HEIGHT) break;
        batchStart += batchCount;
    }

    if (inBounds) {
        C = mix(C, outlineColor, outlineWeight);
        imageStore(outputImage, ivec2(pixel), vec4(C, 1.0 - T));
    }
}

void main() {
    if (pc.rasterSharedMemoryMode == 1u) renderShared();
    else renderOriginal();
}
