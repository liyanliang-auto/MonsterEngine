// splat_tile_boundaries.comp - Tile Boundary Detection
//
// After radix sort, entries are grouped by tile (key >> 32) and sorted
// by depth within each tile. This shader detects adjacent key transitions
// to build per-tile [start, end) ranges for the render pass.
//
// Reference: 3dgs-vulkan-cpp tile_boundaries.comp / 3DGS.cpp tile_boundary.comp

#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// ============================================================================
// Descriptor Set 0
// ============================================================================

layout(std430, set = 0, binding = 0) readonly buffer SortedKeys {
    uvec2 keys[];               // x = depth bits, y = full tile ID
};

layout(std430, set = 0, binding = 1) buffer TileRanges {
    uvec2 ranges[];             // [tileID].x = start (inclusive), .y = end (exclusive)
};

layout(std430, set = 0, binding = 2) readonly buffer DispatchState { uint state[]; };

// ============================================================================
// Push Constants (12 bytes: 3 x uint32)
// ============================================================================
layout(push_constant) uniform PushConstants {
    uint numRendered;           // Total number of sorted entries
    uint numTiles;              // Total tile count (gridX * gridY)
    uint mode;                  // 0 = boundary detection, 1 = clear all tiles to (0,0)
} pc;

// ============================================================================
// Main
// ============================================================================
void main() {
    uint idx = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 256u + gl_LocalInvocationID.x;
    if (pc.mode == 1u) {
        if (idx < pc.numTiles) ranges[idx] = uvec2(0u);
        return;
    }
    uint count = pc.numRendered == 0xffffffffu ? state[0] : pc.numRendered;
    if (idx >= count) return;
    uint tile = keys[idx].y;
    if (tile >= pc.numTiles) return;
    if (idx == 0u) ranges[tile].x = 0u;
    else {
        uint previous = keys[idx - 1u].y;
        if (tile != previous) {
            ranges[tile].x = idx;
            if (previous < pc.numTiles) ranges[previous].y = idx;
        }
    }
    // Includes singleton lists: do not return after marking the first entry.
    if (idx == count - 1u) ranges[tile].y = count;
}
