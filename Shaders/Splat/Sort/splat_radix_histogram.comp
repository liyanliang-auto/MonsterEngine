// splat_radix_histogram.comp - Radix Sort Histogram Pass
//
// Each workgroup computes a local 256-bin histogram of the input keys for
// the current radix pass. Results are written to a global histogram buffer.
//
// Based on VkRadixSort by Mirco Werner (MIT License):
// https://github.com/MircoWerner/VkRadixSort

#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : enable

#define WORKGROUP_SIZE 256
#define RADIX_SORT_BINS 256U

layout(local_size_x = WORKGROUP_SIZE, local_size_y = 1, local_size_z = 1) in;

// ============================================================================
// Descriptor Set 0
// ============================================================================

layout(std430, set = 0, binding = 0) readonly buffer KeysIn {
    uint64_t keys[];
};

layout(std430, set = 0, binding = 1) buffer HistogramOut {
    uint histograms[];  // [RADIX_SORT_BINS * g_num_workgroups], per-WG histogram rows
};

// ============================================================================
// Push Constants (16 bytes)
// ============================================================================
layout(push_constant) uniform PushConstants {
    uint g_num_elements;
    uint g_shift;
    uint g_num_workgroups;
    uint g_num_blocks_per_workgroup;
} pc;

// ============================================================================
// Shared Memory
// ============================================================================
shared uint histogram[RADIX_SORT_BINS];

void main() {
    uint gID = gl_GlobalInvocationID.x;
    uint lID = gl_LocalInvocationID.x;
    uint wID = gl_WorkGroupID.x;

    // Initialize shared histogram
    if (lID < RADIX_SORT_BINS) {
        histogram[lID] = 0U;
    }
    barrier();

    // Count keys into local histogram bins
    for (uint block = 0u; block < pc.g_num_blocks_per_workgroup; block++) {
        uint elementId = wID * pc.g_num_blocks_per_workgroup * WORKGROUP_SIZE
                       + block * WORKGROUP_SIZE + lID;
        if (elementId < pc.g_num_elements) {
            uint bin = uint(keys[elementId] >> pc.g_shift) & (RADIX_SORT_BINS - 1u);
            atomicAdd(histogram[bin], 1U);
        }
    }
    barrier();

    // Write local histogram to global buffer
    if (lID < RADIX_SORT_BINS) {
        histograms[RADIX_SORT_BINS * wID + lID] = histogram[lID];
    }
}
