// splat_radix_scatter.comp - Radix Sort Scatter Pass
//
// Reads global offsets from the offsets pass, and scatters each
// key-value pair to its sorted position in the output buffers.
//
// Based on VkRadixSort by Mirco Werner (MIT License):
// https://github.com/MircoWerner/VkRadixSort

#version 450
#extension GL_KHR_shader_subgroup_basic      : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_ballot     : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : enable

#define WORKGROUP_SIZE 256
#define RADIX_SORT_BINS 256U

layout(local_size_x = WORKGROUP_SIZE, local_size_y = 1, local_size_z = 1) in;

// ============================================================================
// Descriptor Set 0
// ============================================================================

layout(std430, set = 0, binding = 0) readonly buffer KeysIn {
    uint64_t keys_in[];
};

layout(std430, set = 0, binding = 1) buffer KeysOut {
    uint64_t keys_out[];
};

layout(std430, set = 0, binding = 2) readonly buffer ValuesIn {
    uint values_in[];
};

layout(std430, set = 0, binding = 3) buffer ValuesOut {
    uint values_out[];
};

layout(std430, set = 0, binding = 4) readonly buffer HistogramBuf {
    uint histograms[];  // [RADIX_SORT_BINS * g_num_workgroups]
};

layout(std430, set = 0, binding = 5) readonly buffer DispatchState { uint state[]; };

// ============================================================================
// Push Constants (16 bytes)
// ============================================================================
layout(push_constant) uniform PushConstants {
    uint g_num_elements;
    uint g_shift;
    uint g_num_workgroups;
    uint g_num_blocks_per_workgroup;
} pc;

// ============================================================================
// Shared Memory
// ============================================================================
shared uint global_offsets[RADIX_SORT_BINS];             // global exclusive scan per bin

// Bin flags: native shared 32-bit atomics track which threads
// have written to which bin. Used to compute per-bin intra-workgroup ordering.
shared uint bin_flags[RADIX_SORT_BINS][WORKGROUP_SIZE / 32u];

void main() {
    bool gpuCount = pc.g_num_elements == 0xffffffffu;
    uint numElements = gpuCount ? state[0] : pc.g_num_elements;
    uint numWorkgroups = gpuCount ? state[3] : pc.g_num_workgroups;
    if (gpuCount && state[1] != 0u) return;
    if (pc.g_num_blocks_per_workgroup != 4u && pc.g_num_blocks_per_workgroup != 8u &&
        pc.g_num_blocks_per_workgroup != 16u && pc.g_num_blocks_per_workgroup != 32u) return;
    if (numWorkgroups > pc.g_num_workgroups || numWorkgroups > histograms.length() / RADIX_SORT_BINS ||
        numElements > keys_in.length() || numElements > keys_out.length() ||
        numElements > values_in.length() || numElements > values_out.length() ||
        gl_WorkGroupID.x >= numWorkgroups) return;

    uint gID  = gl_GlobalInvocationID.x;
    uint lID  = gl_LocalInvocationID.x;
    uint wID  = gl_WorkGroupID.x;

    // ========================================================================
    // Phase 1: Load precomputed global offsets
    // ========================================================================

    global_offsets[lID] = histograms[RADIX_SORT_BINS * wID + lID];
    barrier();

    // ========================================================================
    // Phase 2: Scatter elements to sorted output
    // ========================================================================

    uint flags_bin  = lID / 32u;
    uint flags_bit = 1u << (lID % 32u);

    for (uint block = 0u; block < pc.g_num_blocks_per_workgroup; block++) {
        uint elementId = wID * pc.g_num_blocks_per_workgroup * WORKGROUP_SIZE
                       + block * WORKGROUP_SIZE + lID;

        // Init bin flags
        if (lID < RADIX_SORT_BINS) {
            for (int i = 0; i < int(WORKGROUP_SIZE / 32u); i++) {
                bin_flags[lID][i] = 0u;
            }
        }
        barrier();

        uint64_t key_in = 0UL;
        uint value_in    = 0u;
        uint binID       = 0u;
        uint binOffset   = 0u;

        if (elementId < numElements) {
            key_in  = keys_in[elementId];
            value_in = values_in[elementId];

            binID = uint(key_in >> pc.g_shift) & (RADIX_SORT_BINS - 1u);
            binOffset = global_offsets[binID];

            // Mark this thread in the bin's flag array
            atomicOr(bin_flags[binID][flags_bin], flags_bit);
        }
        barrier();

        if (elementId < numElements) {
            // Compute this element's position within the bin by counting
            // how many threads before us wrote to the same bin
            uint prefix = 0u;
            uint count  = 0u;

            for (uint i = 0u; i < WORKGROUP_SIZE / 32u; i++) {
                uint bits = bin_flags[binID][i];

                uint full_count    = bitCount(bits);
                uint partial_count = bitCount(bits & (flags_bit - 1u));

                prefix += (i < flags_bin) ? full_count : 0u;
                prefix += (i == flags_bin) ? partial_count : 0u;
                count  += full_count;
            }

            keys_out[binOffset + prefix]   = key_in;
            values_out[binOffset + prefix] = value_in;

            // The last input lane in this bin advances the shared offset for
            // the next block. Global workgroup order came from the offsets pass.
            if (prefix == count - 1u) {
                atomicAdd(global_offsets[binID], count);
            }
        }

        barrier();
    }
}
