#include <windows.h>
#include "resource.h"
#pragma code_page(65001)

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

STRINGTABLE
BEGIN
    IDS_APP_TITLE "MonsterStudio - VideoTo3D 视频重建"
    IDS_CREATE "创建项目..."
    IDS_OPEN "打开项目..."
    IDS_ADD "加入待办计划"
    IDS_UP "上移"
    IDS_DOWN "下移"
    IDS_CANCEL "取消待办"
    IDS_PROJECT_NONE "尚未打开项目。请选择创建或打开。"
    IDS_PROJECT_INFO "项目：%s    ID：%s    修订：%llu\r\n目录：%s"
    IDS_REQUEST_LABEL "计划请求（仅保存文字配置，不导入媒体）："
    IDS_QUEUE_LABEL "待办及历史记录："
    IDS_STATUS_READY "就绪。计划条目不会自动执行。"
    IDS_STATUS_BUSY "正在处理，请稍候..."
    IDS_STATUS_SAVED "项目已持久保存。"
    IDS_STATUS_NO_CHANGE "队列顺序未变化。"
    IDS_STATUS_ERROR "操作失败："
    IDS_UNAVAILABLE "安全暂停/恢复仅支持 Brush 训练；准备阶段只能强制停止。待办计划仅保存文字，不执行。"
    IDS_PLAN_ONLY "仅计划，未开始生成"
    IDS_CREATE_PROMPT "项目名称（将在所选父目录下建立同名项目目录）："
    IDS_SELECT_PARENT "选择项目的父目录"
    IDS_SELECT_PROJECT "选择已有 MonsterStudio 项目目录"
    IDS_NAME_REQUIRED "请输入项目名称。"
    IDS_REQUEST_REQUIRED "请输入要保存的计划请求文字。"
    IDS_SELECT_RUN "请先选择一条待办记录。"
    IDS_CLOSE_WAIT "正在等待当前操作安全结束：训练会请求暂停保存，准备阶段会强制停止；导入会继续完成。"
    IDS_STATE_PENDING "待办"
    IDS_STATE_RUNNING "运行中（历史状态）"
    IDS_STATE_PAUSING "暂停中（历史状态）"
    IDS_STATE_CANCELING "取消中（历史状态）"
    IDS_STATE_INTERRUPTED "已中断；此版本不能恢复"
    IDS_STATE_CANCELED "已取消"
    IDS_STATE_FAILED "失败"
    IDS_REQUEST_TOO_LARGE "请求文字超出 64 KiB 限制。"
    IDS_INITIAL_REQUEST "例如：场景说明、预期输入和参数。此处只保存计划文字。"
    IDS_FOLDER_ERROR "无法选择目录。"
    IDS_ACTION_ERROR "无法完成操作。"
    IDS_INTERRUPTED_NOTE "打开时已将历史活动状态持久标记为中断；此版本不会自动恢复计算。"
    IDS_INIT_ERROR "无法初始化 Windows 对话框组件。"
    IDS_IMPORT_VIDEO "导入视频..."
    IDS_SELECT_VIDEO "选择要复制到项目的视频"
    IDS_INPUT_NONE "项目尚未导入输入。"
    IDS_INPUT_ERROR "无法验证项目已有输入，请检查文件和权限："
    IDS_IMPORT_PREFLIGHT "正在检查视频、项目空间和写入权限（仅导入预算；容量为即时观察，并未预留）..."
    IDS_IMPORT_COPYING "正在复制、校验并发布项目自有视频，请稍候..."
    IDS_INPUT_INSPECTING "正在读取并校验项目已有输入..."
    IDS_IMPORT_SUCCESS "视频已复制、校验并发布。输入身份与项目内路径见上方；尚未解码或开始重建。"
    IDS_VIDEO_ERROR "无法打开视频选择框，请重试。"
    IDS_INPUT_VIDEO "视频"
    IDS_INPUT_PHOTOS "照片"
    IDS_CONFIG "高级配置..."
    IDS_START_RECONSTRUCTION "开始重建"
    IDS_PAUSE_RECONSTRUCTION "暂停并保存"
    IDS_RESUME_RECONSTRUCTION "恢复训练"
    IDS_FORCE_STOP "强制停止(未存丢失)"
    IDS_SELECT_CONFIG "安装已信任的本地运行环境配置；高级配置将保留自定义参数"
    IDS_EXECUTION_NONE "导入视频后可直接开始重建，默认中预设；运行环境仅需设置一次。导入或计划保存不代表完成。"
    IDS_PREVIEW_LOAD "查看结果 / 重新加载"
    IDS_PREVIEW_RESET "复位视角"
    IDS_PREVIEW_UNLOADED "尚无三维预览。打开已完成项目或重建完成后自动显示；拖动旋转，滚轮缩放。"
    IDS_QUALITY "质量："
    IDS_QUALITY_LOW "低"
    IDS_QUALITY_MEDIUM "中（默认）"
    IDS_QUALITY_HIGH "高"
    IDS_QUALITY_ADVANCED "高级："
    IDS_RUNTIME_SETUP "设置运行环境..."
    IDS_RUNTIME_READY "运行环境已验证并保存，下次启动可继续使用。新任务采用当前预设；恢复沿用原任务配置。"
END

IDD_CREATE_PROJECT DIALOGEX 0, 0, 260, 81
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "创建 MonsterStudio 项目"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "项目名称：", IDC_CREATE_PROMPT, 8, 9, 244, 12
    EDITTEXT IDC_CREATE_NAME, 8, 25, 244, 15, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "确定", IDOK, 139, 55, 53, 17
    PUSHBUTTON "取消", IDCANCEL, 199, 55, 53, 17
END

1 RT_MANIFEST "MonsterStudio.manifest"
