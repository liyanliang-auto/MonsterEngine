#version 450
#extension GL_GOOGLE_include_directive : require
#include "splat_tight_culling.glsl"
layout(local_size_x=64) in;
struct Fixture { vec4 conic; vec4 center; uvec4 rect; uvec4 image; };
layout(std430,binding=0) readonly buffer Inputs { Fixture f[]; };
layout(std430,binding=1) writeonly buffer Outputs { uint retained[]; };
layout(push_constant) uniform PC { uint count; } pc;
void main() {
    uint i=gl_GlobalInvocationID.x;
    if(i>=pc.count) return;
    Fixture v=f[i];
    SplatTightSupport s=splatTightSupport(v.conic,v.center.xy);
    uvec4 rect=splatTightRect(v.rect,v.center.xy,s,(v.image.xy+15u)/16u,v.image.z);
    for(uint y=0;y<8u;++y) for(uint x=0;x<8u;++x) {
        bool inside=x>=rect.x&&x<rect.z&&y>=rect.y&&y<rect.w;
        retained[i*64u+y*8u+x]=(inside&&splatTileRetained(uvec2(x,y),v.center.xy,s,v.image.xy,v.image.z))?1u:0u;
    }
}
